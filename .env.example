# StudioGrid AI — Environment Variables Example
# Copy this file to .env.local for local development
# NEVER commit .env or .env.local to Git

# ─────────────────────────────────────────
# Application
# ─────────────────────────────────────────
APP_ENV=development
# Options: development | production | test

# ─────────────────────────────────────────
# Backend API
# ─────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:3000

# ─────────────────────────────────────────
# Google Cloud real agent runtime (ADC only)
# ─────────────────────────────────────────
STUDIOGRID_AI_ENABLED=false
STUDIOGRID_FIRESTORE_ENABLED=false
STUDIOGRID_TOOL_SERVER_URL=http://127.0.0.1:8000
STUDIOGRID_PRODUCTION_ID=last-light-demo
GOOGLE_CLOUD_PROJECT=studiogrid-ai
GOOGLE_CLOUD_LOCATION=global
GOOGLE_CLOUD_AGENT_ENGINE_LOCATION=europe-west3
# Use Application Default Credentials — do NOT set a key file path here
# Run: gcloud auth application-default login

# ─────────────────────────────────────────
# Firestore (Phase 2)
# ─────────────────────────────────────────
FIRESTORE_DATABASE=(default)
# Local dev uses in-memory store when FIRESTORE_DATABASE is not set

# ─────────────────────────────────────────
# Gemini / Agent Builder (Phase 2)
# ─────────────────────────────────────────
GEMINI_MODEL=gemini-3.6-flash
# Credentials via ADC — do NOT paste API keys here

# ─────────────────────────────────────────
# Partner Integration (status: NOT_CONFIGURED)
# ─────────────────────────────────────────
# PARTNER_SERVICE=none
# Uncomment and configure only after official contest partner requirements confirmed

# ─────────────────────────────────────────
# Frontend (Next.js)
# ─────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_APP_ENV=development
